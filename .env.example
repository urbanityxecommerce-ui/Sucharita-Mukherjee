# ============================================================================
# EXACT ENVIRONMENT VARIABLES FOR NETLIFY / CLOUD RUN / PRODUCTION DEPLOYMENT
# ============================================================================

# 1. GROQ_API_KEY (Primary Ultra-Fast AI Engine — Recommended #1)
# Get free/instant key from: https://console.groq.com/keys
GROQ_API_KEY="YOUR_GROQ_API_KEY"
VITE_GROQ_API_KEY="YOUR_GROQ_API_KEY"

# 2. GEMINI_API_KEY (Google Gemini AI Engine + Vision Image Analysis)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 3. OPENROUTER_API_KEY (Optional Backup Multi-Model AI Engine)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
VITE_OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# 4. APP_URL (Optional — Your live deployed URL)
APP_URL="https://your-site-name.netlify.app"

